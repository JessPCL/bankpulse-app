<!-- MVC-BP-08 - Vista checkout.ejs (HU-BP-03): resultado de reservar con compra -->
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><title>BANKPULSE - Checkout</title>
<style>body{font-family:Arial,sans-serif;max-width:860px;margin:2rem auto;padding:0 1rem;color:#222}h1{color:#1f3864}table{border-collapse:collapse;width:100%;margin:1rem 0}th,td{border:1px solid #bbb;padding:.4rem .6rem;text-align:left}th{background:#d9e2f3}.error{background:#fde8e8;border-left:4px solid #c0392b;padding:.6rem 1rem}.ok{background:#e7f6ec;border-left:4px solid #2e8b57;padding:.6rem 1rem}input,button{padding:.35rem;margin:.15rem}a{color:#2e5597}</style></head><body>
<h1>Resumen de reserva y pago</h1>
<% if (locals.error) { %><div class="error"><strong><%= error %></strong><ul><% (locals.detalle || []).forEach(function(d){ %><li><%= d %></li><% }) %></ul></div><% } %>
<% if (locals.reserva) { %>
<div class="ok"><%= locals.mensaje %></div>
<table>
<tr><th>Restaurante</th><td><%= reserva.restaurante %></td></tr>
<tr><th>Fecha y hora</th><td><%= reserva.fecha %> <%= reserva.hora %></td></tr>
<tr><th>Comensales</th><td><%= reserva.comensales %></td></tr>
<tr><th>Monto</th><td>USD <%= reserva.monto %></td></tr>
<tr><th>Pago</th><td><%= reserva.estado_pago %> (<%= reserva.referencia_pago %>)</td></tr>
<tr><th>Codigo de confirmacion</th><td><strong><%= reserva.codigo_confirmacion %></strong></td></tr>
</table>
<p><a href="/reservas/<%= reserva.codigo_confirmacion %>">Ver confirmacion digital</a></p>
<% } %>
<p><a href="/restaurantes">&larr; Volver a la busqueda</a></p>
</body></html>
